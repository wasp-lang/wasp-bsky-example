# Wasp only exposes the OAuth helpers the Bluesky handlers use when at least one
# built-in OAuth provider is enabled. Google is enabled for that reason alone,
# so these values are never used and can stay as dummies.
GOOGLE_CLIENT_ID=x
GOOGLE_CLIENT_SECRET=x

# AT Protocol's development exception only accepts loopback IPs as redirect
# URIs, never `localhost`, so point Wasp at 127.0.0.1 instead of the default.
# The port itself doesn't matter, it is ignored when matching loopback redirect
# URIs, so set PORT here too if 3001 is taken on your machine.
WASP_SERVER_URL=http://127.0.0.1:3001
WASP_WEB_CLIENT_URL=http://127.0.0.1:3000

# Production only. Once the server is reachable over HTTPS, the loopback
# exception no longer applies and the app becomes a confidential OAuth client
# that signs its token requests. Generate a single-line ES256 private JWK with:
#
#   node --input-type=module -e "import {generateKeyPair,exportJWK} from 'jose'; const {privateKey} = await generateKeyPair('ES256', {extractable: true}); console.log(JSON.stringify({...await exportJWK(privateKey), alg: 'ES256'}))"
#
# BLUESKY_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","alg":"ES256"}
